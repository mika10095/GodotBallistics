; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ballistics"
run/main_scene="res://addons/NCBS/Scenes/menu.tscn"
config/features=PackedStringArray("4.2", "C#", "Mobile")
boot_splash/bg_color=Color(0.407843, 0.462745, 0.470588, 1)
boot_splash/image="res://addons/NCBS/icon.png"
config/icon="res://addons/NCBS/icon.png"

[autoload]

FollowObjectManager="*res://addons/NCBS/Resources/Scripts/follow_object_manager.gd"
PrototypeTrajectory="*res://addons/NCBS/Resources/Scripts/prototype_trajectory.gd"

[display]

window/vsync/vsync_mode=2

[dotnet]

project/assembly_name="Projects"

[editor_plugins]

enabled=PackedStringArray("res://addons/NCBS/plugin.cfg", "res://addons/m_terrain/plugin.cfg")

[filesystem]

import/fbx/enabled=false

[input]

