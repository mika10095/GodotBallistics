; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ballistics"
config/version="0.5.1"
run/main_scene="res://Scenes/menu.tscn"
config/features=PackedStringArray("4.2", "C#", "Mobile")
boot_splash/bg_color=Color(0.407843, 0.462745, 0.470588, 1)
boot_splash/image="res://icon.png"
config/icon="res://icon.png"

[autoload]

FollowObjectManager="*res://Resources/Scripts/Camera/follow_object_manager.gd"
TimeManager="*res://Resources/Scripts/Utility/time_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[dotnet]

project/assembly_name="NCBS"

[editor_plugins]

enabled=PackedStringArray("res://addons/MonoBuildToggler/plugin.cfg", "res://addons/anthonyec.camera_preview/plugin.cfg", "res://addons/format_on_save/plugin.cfg", "res://addons/terrain_3d/plugin.cfg", "res://addons/timer/plugin.cfg")

[filesystem]

import/blender/enabled=false
import/fbx/enabled=false

[importer_defaults]

animation_library={
"animation/fps": 24.0,
"animation/trimming": true
}

