[sub_resource type="GDScript" id="GDScript_i31vg"]
resource_name = "StarDrop"
script/source = "extends JoltGeneric6DOFJoint3D

@onready var target = $\"..\"


# Called when the node enters the scene tree for the first time.
func _ready():
	target.target_hit.connect(detach)


func detach()-> void:
	print_debug(\"Hit off star part!\")
	enabled = false
	

"

