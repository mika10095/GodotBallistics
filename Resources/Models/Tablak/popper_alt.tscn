[sub_resource type="GDScript" id="GDScript_aukwq"]
resource_name = "Popper"
script/source = "extends JoltHingeJoint3D
@onready var rigid_body_3d = $RigidBody3D


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _physics_process(delta):
	#print_debug(rad_to_deg(rigid_body_3d.rotation.x))
	if rad_to_deg(rigid_body_3d.rotation.x) >= 4.5:
		motor_enabled = false
	elif rad_to_deg(rigid_body_3d.rotation.x) < -75:
			motor_enabled = true
"

